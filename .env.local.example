# Copy this file to .env.local and fill in your Supabase project values
# Find these in Supabase: Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The default seller WhatsApp/phone number (used when a product doesn't set its own)
# Format: country code + number, no plus sign, no spaces (e.g. 233241234567)
NEXT_PUBLIC_DEFAULT_SELLER_PHONE=233541901749
